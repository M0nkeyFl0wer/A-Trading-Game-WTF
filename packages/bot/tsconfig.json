{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // composite is required for any project listed in another tsconfig's "references"
    // (api/tsconfig.json references this one; without it `tsc -b` fails with TS6306).
    "composite": true,
    "outDir": "dist",
    "rootDir": "src",
    "declaration": true,
    "declarationMap": true,
    // CommonJS emit so plain Node can require() this package (see packages/shared/tsconfig.json).
    "module": "CommonJS",
    "moduleResolution": "Node",
    "verbatimModuleSyntax": false
  },
  "include": ["src"],
  "references": [
    { "path": "../shared" },
    { "path": "../core" }
  ]
}

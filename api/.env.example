# =============================================================================
# api/.env  —  environment contract for the Trading Game API
# =============================================================================
# This file is loaded by api/lib/loadEnv.ts (Node's built-in process.loadEnvFile)
# the moment api/server.ts starts. Variables already present in the shell WIN;
# the file only fills in what is missing. Copy this file to `api/.env` and edit.
#
# CONTRACT (verified 2026-08-28):
#   * NOTHING is required to boot. Every variable below has a working default.
#   * Without REAL Firebase Admin credentials you MUST set AUTH_DEV_BYPASS=true,
#     otherwise every /api/room route answers 503 AuthUnavailable.
#     AUTH_DEV_BYPASS=true is refused (process exits) when NODE_ENV=production.
#   * For a quick friend test, copy `.env.test.example` instead — it already has
#     the bypass switched on.
# =============================================================================

# --- Server -------------------------------------------------------------------
# TCP port the API listens on. The Vite dev client (apps/web) expects 3001.
PORT=3001
# Interface to bind. 0.0.0.0 = every interface; use 127.0.0.1 behind a proxy.
HOST=0.0.0.0
# development | production | test. `production` refuses AUTH_DEV_BYPASS=true and
# switches the CORS allowlist to the Vercel hostnames.
NODE_ENV=development
# pino log level: trace | debug | info | warn | error. Default: debug in
# development, info in production.
LOG_LEVEL=debug

# --- Auth ---------------------------------------------------------------------
# true  = skip Firebase and treat every request as AUTH_DEV_USER_ID (local only).
# false = verify Firebase ID tokens; needs the FIREBASE_* block below.
AUTH_DEV_BYPASS=false
# Identity handed to every request while the bypass is on.
AUTH_DEV_USER_ID=dev-user
AUTH_DEV_USER_EMAIL=dev@example.com

# --- Firebase Admin (only when AUTH_DEV_BYPASS=false) -------------------------
# Leave these COMMENTED OUT unless you paste real service-account values.
# Placeholders pass the "is it set?" check and then fail PEM parsing, which is
# exactly how every /api/room route ended up returning 503.
#FIREBASE_PROJECT_ID=your_firebase_project_id
#FIREBASE_CLIENT_EMAIL=firebase-adminsdk@example.iam.gserviceaccount.com
#FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# --- Storage ------------------------------------------------------------------
# SQLite file for rooms, audit chain and signing key. Default: api/data/game.db
# (the directory is created on first boot).
#DB_PATH=./data/game.db
# Reserved: base directory for on-disk state. Not read by the code yet; DB_PATH
# is the switch that works today. Documented so deploy scripts can set it now.
#DATA_DIR=./data

# --- Voice (optional) ---------------------------------------------------------
# Server-side ElevenLabs proxy. Unset -> /api/voice returns 503 and the client
# falls back to the browser's Web Speech API. Never commit a real key.
#ELEVENLABS_API_KEY=
ELEVENLABS_API_URL=https://api.elevenlabs.io/v1

# --- HTTP hardening (optional) ------------------------------------------------
# Comma-separated browser origins allowed by CORS. Reserved for the CORS
# allowlist change; until it lands the API accepts localhost:3000/3001 in
# development and the Vercel hosts in production.
#ALLOWED_ORIGINS=http://localhost:3000
# Where browsers POST Content-Security-Policy violation reports. Unset = none.
#CSP_REPORT_URI=
# Shared secret checked by the external-API guard (X-API-Key header). Unset =
# those routes reject every caller.
#EXTERNAL_API_KEY=

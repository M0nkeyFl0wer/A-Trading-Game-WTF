{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    // The base config enables verbatimModuleSyntax, which is incompatible with CommonJS
    // emit (TS1295/TS1287). The api is a plain-Node CJS program, so turn it off here.
    "verbatimModuleSyntax": false,
    "lib": ["ES2020"],
    "outDir": "./dist",
    "rootDir": "./",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true
  },
  "include": [
    "**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "tests",
    "**/*.test.ts",
    "vitest.config.ts",
    "game.ts"
  ],
  "references": [
    { "path": "../packages/shared" },
    { "path": "../packages/core" },
    { "path": "../packages/bot" }
  ]
}

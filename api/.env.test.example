# =============================================================================
# api/.env.test.example — copy to api/.env for a LOCAL friend test.
# =============================================================================
# Same contract as .env.example (see the header there). The only difference:
# the Firebase bypass is ON so the API answers without any credentials.
# Never use this file with NODE_ENV=production — the server refuses to start.
# =============================================================================

PORT=3001
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=debug

# Everyone is "dev-user". No Firebase needed.
AUTH_DEV_BYPASS=true
AUTH_DEV_USER_ID=dev-user
AUTH_DEV_USER_EMAIL=dev@example.com

# Voice stays off (503 -> client falls back to Web Speech) unless you add a key.
#ELEVENLABS_API_KEY=
ELEVENLABS_API_URL=https://api.elevenlabs.io/v1

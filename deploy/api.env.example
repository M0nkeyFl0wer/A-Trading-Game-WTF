# Environment for trading-game-api.service (copy to ~/.config/trading-game/api.env).
# Nothing is required to BOOT; without real Firebase Admin creds you MUST set
# AUTH_DEV_BYPASS=true or every /api/room route returns 503 AuthUnavailable.

PORT=8019
HOST=127.0.0.1

# Friend-test identity mode (refused when NODE_ENV=production).
AUTH_DEV_BYPASS=true

# Browser origins allowed to call the API (comma-separated). Read once the
# ALLOWED_ORIGINS change lands (issue: CORS allowlist); until then the API
# only accepts localhost:3000/3001.
ALLOWED_ORIGINS=https://trading.elephantroom.ca

# SQLite + Ed25519 signing key location (defaults to api/data/ when unset).
DB_PATH=/home/m0nk/Projects/A-Trading-Game-WTF/api/data/game.db

# Optional: server-side ElevenLabs voice. Leave unset -> /api/voice returns 503
# and the client falls back to Web Speech. Store the real key in the keyring
# and render this file from it; never commit a value here.
#ELEVENLABS_API_KEY=

LOG_LEVEL=info
